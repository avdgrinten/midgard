#!/bin/sh
# Creates midgard's default user and starts their OpenRC user services (midgard's agent
# runs it as root on every boot, once the guest booted and before sessions run:
# `user-setup`).
set -eu
user=$1
id "$user" >/dev/null 2>&1 || adduser -D -s /bin/sh "$user"
home=$(awk -F: -v user="$user" '$1 == user { print $6 }' /etc/passwd)
runlevel="$home/.config/rc/runlevels/default"
if [ ! -d "$runlevel" ]; then
    mkdir -p "$runlevel"
    for service in dbus midgard-waypipe; do
        ln -s "/etc/user/init.d/$service" "$runlevel/$service"
    done
    chown -R "$(id -u "$user"):$(id -g "$user")" "$home/.config"
fi
[ -e "/etc/init.d/user.$user" ] || ln -s user "/etc/init.d/user.$user"
rc-service -q "user.$user" start
# The user's OpenRC instance starts its services in the background; sessions find them
# running (we wait up to 30 s).
uid=$(id -u "$user")
tries=600
while [ "$(cat "/run/user/$uid/openrc/softlevel" 2>/dev/null)" != default ] ||
    pgrep -u "$uid" -x openrc >/dev/null; do
    tries=$((tries - 1))
    [ "$tries" -gt 0 ] || break
    sleep 0.05
done
